{
  "$id": "https://east.example/contracts/v5-runtime-packages/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version", "content_sha256", "locator"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "issue_key", "run_id", "attempt", "mode", "base_database_version", "inputs", "payload_sha256"],
      "properties": {
        "schema_version": {"type": "string"},
        "issue_key": {"type": "string"},
        "run_id": {"type": "string"},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "mode": {"enum": ["event", "foundation"]},
        "base_database_version": {"type": "string"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "structure_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "constraint_asset_version", "graph_version", "tables", "fields", "references"],
      "properties": {
        "schema_version": {"const": "v5.structure-closure/v1"},
        "constraint_asset_version": {"const": "CA-V0.3.0"},
        "graph_version": {"const": "TRG-V1.0.0"},
        "tables": {"type": "array"}, "fields": {"type": "array"}, "references": {"type": "array"},
        "foundation_task_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      }
    },
    "operation_closure": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "mode", "operations", "consumers"],
      "properties": {
        "schema_version": {"const": "v5.operation-closure/v1"},
        "mode": {"const": "event"},
        "operations": {"type": "array", "minItems": 1},
        "consumers": {"const": ["241", "251"]}
      }
    },
    "foundation_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "foundation_task_ref", "base_database_version", "target_classes", "target_counts", "constraint_asset_version", "graph_version"],
      "properties": {
        "schema_version": {"const": "v5.foundation-profile/v1"},
        "foundation_task_ref": {"$ref": "#/$defs/runtime_artifact_ref"},
        "base_database_version": {"type": "string"},
        "target_classes": {"type": "array", "minItems": 1},
        "target_counts": {"type": "object"},
        "constraint_asset_version": {"const": "CA-V0.3.0"},
        "graph_version": {"const": "TRG-V1.0.0"}
      }
    },
    "runtime_artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "foundation_task_package": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "foundation_task_id", "foundation_mode", "trigger_reason", "target_database_version", "target_object_types", "target_table_field_scope", "target_counts", "distribution_targets", "hierarchy_asset_refs", "prohibited_record_types", "resume_qa_ref", "constraint_asset_version", "graph_version"],
      "properties": {
        "schema_version": {"const": "v5.foundation-task-package/v1"},
        "foundation_task_id": {"type": "string", "minLength": 1},
        "foundation_mode": {"enum": ["initial_seed", "expansion"]},
        "trigger_reason": {"type": "string", "minLength": 1},
        "target_database_version": {"type": "string", "minLength": 1},
        "target_object_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "target_table_field_scope": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
        "target_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "distribution_targets": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}},
        "hierarchy_asset_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime_artifact_ref"}},
        "prohibited_record_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "resume_qa_ref": {"anyOf": [{"$ref": "#/$defs/runtime_artifact_ref"}, {"type": "null"}]},
        "constraint_asset_version": {"const": "CA-V0.3.0"},
        "graph_version": {"const": "TRG-V1.0.0"}
      }
    },
    "snapshot_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "database_version", "content_sha256", "read_scope"],
      "properties": {
        "schema_version": {"const": "v5.database-snapshot-ref/v1"},
        "database_version": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "read_scope": {"type": "array"}
      }
    },
    "placeholder_map": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation_closure_sha256", "bindings"],
      "properties": {
        "schema_version": {"const": "v5.placeholder-map/v1"},
        "operation_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bindings": {"type": "array"}
      }
    },
    "verified_data": {"$ref": "foundation-verified-data.schema.json"},
    "foundation_write_batch": {"$ref": "foundation-write-batch.schema.json"},
    "database_copy_regression": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "base_database_version", "candidate_database_version", "input_sha256", "sql_results", "rollback_verified", "content_sha256"],
      "properties": {
        "schema_version": {"const": "v5.database-copy-regression/v1"},
        "base_database_version": {"type": "string"},
        "candidate_database_version": {"type": "string"},
        "input_sha256": {"type": "string"},
        "sql_results": {"type": "array"},
        "rollback_verified": {"type": "boolean"},
        "content_sha256": {"type": "string"}
      }
    },
    "release_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "candidate_sha256", "released_version", "committed_package_sha256", "approved_by"],
      "properties": {
        "schema_version": {"const": "v5.release-receipt/v1"},
        "candidate_sha256": {"type": "string"},
        "released_version": {"type": "string"},
        "committed_package_sha256": {"type": "string"},
        "approved_by": {"type": "string"}
      }
    }
  }
}
