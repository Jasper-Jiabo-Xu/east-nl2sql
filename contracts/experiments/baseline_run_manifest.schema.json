{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAST V5 pinned native baseline manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "baselines"],
  "properties": {
    "manifest_id": {"type": "string"},
    "baselines": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["baseline_id", "repo_url", "commit", "license", "native_entrypoint", "native_adapter_id", "transport_mode", "cache_namespace", "upstream_evidence", "model_contract", "model_routes", "command", "timeout_seconds"],
        "properties": {
          "baseline_id": {"enum": ["DeepEye-SQL", "DataGallery-Text2SQL", "JoyDataAgent-SQL", "Databao Agent", "ReFoRCE", "AutoLink"]},
          "repo_url": {"type": "string", "pattern": "^https://"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"type": "string", "minLength": 1, "not": {"const": "upstream-license-review-required"}},
          "native_entrypoint": {"type": "object", "additionalProperties": false, "required": ["path", "symbol", "arguments"], "properties": {"path": {"type": "string"}, "symbol": {"type": "string"}, "arguments": {"type": "array", "items": {"type": "string"}}}},
          "native_adapter_id": {"type": "string", "pattern": "_native_v1$"},
          "transport_mode": {"enum": ["native", "fixture_stub"]},
          "cache_namespace": {"type": "string", "minLength": 1},
          "upstream_evidence": {"type": "object"},
          "model_contract": {"type": "object", "additionalProperties": false, "required": ["provider", "model_id", "base_url", "endpoint_kind", "api_key_env", "reasoning_enabled", "temperature", "max_tokens", "timeout_seconds", "retry_count"], "properties": {"provider": {"const": "deepseek_openai_compatible"}, "model_id": {"const": "deepseek-v4-flash"}, "base_url": {"const": "https://api.deepseek.com"}, "endpoint_kind": {"const": "openai_chat_completions"}, "api_key_env": {"const": "DEEPSEEK_API_KEY"}, "reasoning_enabled": {"type": "boolean"}, "temperature": {"type": "number", "const": 0}, "max_tokens": {"type": "integer", "minimum": 1}, "timeout_seconds": {"type": "integer", "minimum": 1}, "retry_count": {"const": 3}}},
          "model_routes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "model", "thinking", "reasoning_effort", "temperature", "max_tokens", "timeout_seconds", "retry_count", "call_budget", "token_budget"], "properties": {"stage": {"type": "string"}, "model": {"const": "deepseek-v4-flash"}, "thinking": {"type": "boolean"}, "reasoning_effort": {"enum": [null, "high"]}, "temperature": {"type": ["number", "null"]}, "max_tokens": {"type": "integer", "minimum": 1}, "timeout_seconds": {"type": "integer", "minimum": 1}, "retry_count": {"const": 3}, "call_budget": {"type": "integer", "minimum": 1}, "token_budget": {"type": "integer", "minimum": 1}}}},
          "provider_overlay": {"type": "object"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
