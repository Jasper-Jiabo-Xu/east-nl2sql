{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAST V5 baseline run manifest",
  "type": "object",
  "required": [
    "manifest_id",
    "baselines"
  ],
  "additionalProperties": true,
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "baselines": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "baseline_id",
          "repo_url",
          "commit",
          "license",
          "native_entrypoint",
          "native_adapter_id",
          "transport_mode",
          "cache_namespace",
          "model_contract",
          "command",
          "timeout_seconds"
        ],
        "properties": {
          "baseline_id": {
            "enum": [
              "DeepEye-SQL",
              "DataGallery-Text2SQL",
              "JoyDataAgent-SQL",
              "Databao Agent",
              "ReFoRCE",
              "AutoLink"
            ]
          },
          "repo_url": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "native_entrypoint": {
            "type": "string"
          },
          "cache_namespace": {
            "type": "string"
          },
          "native_adapter_id": {
            "enum": [
              "deepeye_sql_native_v1",
              "datagallery_text2sql_native_v1",
              "joydataagent_sql_native_v1",
              "databao_agent_native_v1",
              "reforce_native_v1",
              "autolink_native_v1"
            ]
          },
          "transport_mode": {
            "enum": ["native", "fake_transport"]
          },
          "model_contract": {
            "type": "object",
            "required": [
              "provider",
              "model_id",
              "base_url",
              "api_key_env",
              "reasoning_enabled",
              "temperature",
              "max_tokens",
              "timeout_seconds",
              "retry_count"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
