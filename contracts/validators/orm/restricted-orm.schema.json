{
  "$id": "https://east.example/contracts/validators/orm/restricted-orm/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAS-18 restricted_orm input package",
  "type": "object", "additionalProperties": false, "required": ["envelope", "payload"],
  "properties": {
    "envelope": {"type": "object"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "code", "code_sha256", "operation_closure_ref", "operation_ids", "constraint_asset_ref", "typed_reference_graph_ref", "governance_manifest_hash"],
      "properties": {
        "schema_version": {"const": "v5.restricted-orm/v1"}, "code": {"type": "string", "minLength": 1},
        "code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operation_closure_ref": {"$ref": "#/$defs/artifact_ref"}, "operation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "constraint_asset_ref": {"$ref": "#/$defs/asset_ref"}, "typed_reference_graph_ref": {"$ref": "#/$defs/asset_ref"},
        "governance_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "asset_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_type", "asset_version", "content_hash"], "properties": {"artifact_id": {"type": "string"}, "artifact_type": {"type": "string"}, "asset_version": {"type": "string"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
