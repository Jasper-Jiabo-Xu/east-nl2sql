{
  "$id": "https://east.example/contracts/validators/orm/operation-closure/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAS-18 operation_closure input package",
  "type": "object", "additionalProperties": false, "required": ["envelope", "payload"],
  "properties": {
    "envelope": {"type": "object"},
    "payload": {"type": "object", "additionalProperties": false, "required": ["schema_version", "operations", "constraint_asset_ref", "typed_reference_graph_ref", "governance_manifest_hash"], "properties": {"schema_version": {"const": "v5.operation-closure/v1"}, "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["operation_id", "method", "table"], "properties": {"operation_id": {"type": "string"}, "method": {"enum": ["insert", "update", "delete"]}, "table": {"type": "string"}}}}, "constraint_asset_ref": {"$ref": "#/$defs/asset_ref"}, "typed_reference_graph_ref": {"$ref": "#/$defs/asset_ref"}, "governance_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  },
  "$defs": {"asset_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_type", "asset_version", "content_hash"], "properties": {"artifact_id": {"type": "string"}, "artifact_type": {"type": "string"}, "asset_version": {"type": "string"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
