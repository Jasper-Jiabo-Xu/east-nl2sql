{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5.1 Question Input Package",
  "description": "Input package for the V5.1 pipeline: an already-existing question (with optional manual corrections) that enters at Agent 110.",
  "type": "object",
  "required": ["question_id", "question_text", "dataset_source", "answer_contract", "parsed_intent", "quality_assessment"],
  "properties": {
    "question_id": {
      "type": "string",
      "description": "Unique identifier from the 800-question QA JSONL source."
    },
    "question_text": {
      "type": "string",
      "description": "The question text, after manual corrections from issue_registry have been applied."
    },
    "dataset_source": {
      "type": "string",
      "enum": ["east_model", "penalty_case"],
      "description": "Source dataset of the question."
    },
    "answer_contract": {
      "type": "object",
      "description": "Approved answer contract from the QA source; 140 never infers a missing table or field.",
      "additionalProperties": false,
      "required": ["expected_tables", "expected_fields"],
      "properties": {
        "expected_tables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "parsed_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate_conditions"],
      "properties": {
        "predicate_conditions": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["field", "operator", "value"], "properties": {"field": {"type": "string", "minLength": 1}, "operator": {"type": "string", "minLength": 1}, "value": {}}}
        }
      }
    },
    "quality_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_ambiguity", "requires_human_correction"],
      "properties": {"has_ambiguity": {"type": "boolean"}, "requires_human_correction": {"type": "boolean"}}
    },
    "manual_corrections": {
      "type": "array",
      "description": "List of applied corrections from issue_registry.",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {"type": "string"},
          "correction_type": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
