{
  "$id": "https://east.example/contracts/v5_1/gold-lifecycle/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V5.1 two-phase Gold lifecycle state",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_hash", "payload"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^gold-[A-Za-z0-9._:-]+-a[1-3]$"},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "gold_state", "qa_id", "run_id", "trace_id", "attempt", "lineage_id", "candidate_set_hash", "semantic_decision_hash", "execution_evidence_hash", "final_gold_hash", "parent_refs", "input_hashes", "state_at", "failure_code", "question_spec_evidence", "candidate_lock", "release_evidence"],
      "properties": {
        "schema_version": {"const": "v5.1.gold-lifecycle/v1"},
        "gold_state": {"enum": ["semantic_candidate", "execution_confirmed", "formal_released", "blocked_manual"]},
        "qa_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "lineage_id": {"type": "string", "minLength": 1},
        "candidate_set_hash": {"$ref": "#/$defs/hash"},
        "semantic_decision_hash": {"$ref": "#/$defs/hash"},
        "execution_evidence_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "final_gold_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "parent_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
        "input_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}},
        "state_at": {"type": "string", "format": "date-time"},
        "failure_code": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "question_spec_evidence": {"type": "object", "additionalProperties": false, "required": ["reviewed_question_sql_ref", "query_spec_ref", "precheck_report_hash", "deepseek_review_hash", "glm_review_hash", "adjudication_hash"], "properties": {"reviewed_question_sql_ref": {"$ref": "#/$defs/ref"}, "query_spec_ref": {"$ref": "#/$defs/ref"}, "precheck_report_hash": {"$ref": "#/$defs/hash"}, "deepseek_review_hash": {"$ref": "#/$defs/hash"}, "glm_review_hash": {"$ref": "#/$defs/hash"}, "adjudication_hash": {"$ref": "#/$defs/hash"}}},
        "candidate_lock": {"type": "object", "additionalProperties": false, "required": ["round", "candidates"], "properties": {"round": {"const": 1}, "candidates": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "original_sql_hash", "normalized_sql_hash", "lock_evidence_hash", "agreement"], "properties": {"reviewer_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}, "original_sql_hash": {"$ref": "#/$defs/hash"}, "normalized_sql_hash": {"$ref": "#/$defs/hash"}, "lock_evidence_hash": {"$ref": "#/$defs/hash"}, "agreement": {"type": "object", "additionalProperties": false, "required": ["exact", "structural", "execution"], "properties": {"exact": {"type": "boolean"}, "structural": {"type": "boolean"}, "execution": {"type": "boolean"}}}}}}}},
        "release_evidence": {"type": "object", "additionalProperties": false, "required": ["release_candidate_ref", "release_receipt_ref"], "properties": {"release_candidate_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "release_receipt_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}}}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"$ref": "#/$defs/hash"}}}
  }
}
