{
  "$id": "https://east.example/contracts/packages/reviewed-question-sql-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REVIEWED-QUESTION-SQL",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "payload"],
  "properties": {
    "envelope": {
      "allOf": [
        {"$ref": "https://east.example/contracts/common-envelope/v1"},
        {"type": "object", "properties": {"artifact_type": {"const": "reviewed_question_sql"}, "producer_id": {"const": "210"}, "mode": {"const": "event_data"}}}
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qa_id", "candidate_ref", "query_spec_ref", "clear_question", "sql_gold", "sql_explanation", "approved_business_events", "specification_mapping", "evidence_refs", "precheck_report_ref", "deepseek_review_ref", "glm_review_ref", "package_hash", "approved_at"],
      "properties": {
        "qa_id": {"type": "string", "minLength": 1},
        "candidate_ref": {"$ref": "#/$defs/artifact_ref"},
        "query_spec_ref": {"$ref": "#/$defs/artifact_ref"},
        "clear_question": {"type": "string", "minLength": 1},
        "sql_gold": {"type": "string", "minLength": 1},
        "sql_explanation": {"type": "string", "minLength": 1},
        "approved_business_events": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "specification_mapping": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
        "precheck_report_ref": {"$ref": "#/$defs/artifact_ref"},
        "deepseek_review_ref": {"$ref": "#/$defs/artifact_ref"},
        "glm_review_ref": {"$ref": "#/$defs/artifact_ref"},
        "package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
