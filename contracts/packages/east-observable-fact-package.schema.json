{
  "$id": "https://east.example/contracts/packages/east-observable-fact-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAST-OBSERVABLE-FACT-PACKAGE",
  "description": "EAST可观察事实包，由130生产，140/150/170/180消费。将处罚事实映射为EAST可直接/间接观察的事实、表字段路径和可观察边界。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observable_facts",
    "coverage_status",
    "asset_version",
    "east_observable_fact_package_schema_version"
  ],
  "properties": {
    "observable_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observable_fact"
      },
      "description": "可观察事实列表"
    },
    "coverage_status": {
      "type": "string",
      "enum": ["complete", "partial", "blocked"],
      "description": "覆盖状态；complete--完整；partial--部分；blocked--阻断"
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved_item"
      },
      "description": "未解决项；需继续检索或人工判断的项目"
    },
    "asset_version": {
      "type": "string",
      "enum": ["CA-V0.3.0", "TRG-V1.0.0"],
      "description": "使用的约束资产版本"
    },
    "east_observable_fact_package_schema_version": {
      "const": "east-observable-fact-v1",
      "description": "包协议版本"
    }
  },
  "$defs": {
    "observable_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_fact_id",
        "penalty_fact_refs",
        "topic",
        "main_object",
        "query_grain",
        "entry_table",
        "observability_type",
        "mapping_matrix",
        "constraint_asset_refs"
      ],
      "properties": {
        "observable_fact_id": {
          "type": "string",
          "pattern": "^obs-[0-9]{3}$",
          "description": "可观察事实标识；每条EAST可观察事实稳定编号"
        },
        "penalty_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^fact-[0-9]{3}$"
          },
          "minItems": 1,
          "description": "处罚事实引用；被映射的penalty_fact_id列表"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "description": "主题；EAST业务主题"
        },
        "main_object": {
          "type": "string",
          "minLength": 1,
          "description": "主对象；查询核心业务对象"
        },
        "query_grain": {
          "type": "string",
          "minLength": 1,
          "description": "查询粒度；一行结果代表的对象或事件粒度"
        },
        "entry_table": {
          "type": "string",
          "minLength": 1,
          "description": "入口表；EAST标准表ID"
        },
        "related_tables_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/related_table_field"
          },
          "description": "相关表字段；表ID、字段ID及用途"
        },
        "within_table_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/within_table_relation"
          },
          "description": "表内关系；表内字段依赖及约束引用"
        },
        "cross_table_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cross_table_relation"
          },
          "description": "跨表关系；关联路径、连接字段、关系类型及约束引用"
        },
        "time_amount_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_amount_condition"
          },
          "description": "时间和金额条件；可由EAST表达的窗口、阈值和单位"
        },
        "observable_proxy": {
          "type": "string",
          "description": "可观察代理事实；EAST中能够筛查的代理表达"
        },
        "observability_type": {
          "type": "string",
          "enum": ["direct", "indirect", "unobservable"],
          "description": "可观察类型；direct--直接观察；indirect--间接筛查；unobservable--不可观察"
        },
        "unobservable_parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unobservable_part"
          },
          "description": "不可观察部分；无法由EAST证明的处罚事实及原因"
        },
        "risk_screening_boundary": {
          "type": "string",
          "description": "风险筛查边界；明确不直接认定违规"
        },
        "mapping_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping_entry"
          },
          "minItems": 1,
          "description": "逐条映射矩阵；处罚事实→代理事实→表字段/关联→资产证据"
        },
        "constraint_asset_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_asset_ref"
          },
          "minItems": 1,
          "description": "约束资产引用；000返回资产记录引用"
        }
      }
    },
    "related_table_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "field_id", "purpose"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "field_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "within_table_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "field_dependency", "constraint_ref"],
      "properties": {
        "table_id": {"type": "string", "minLength": 1},
        "field_dependency": {"type": "string", "minLength": 1},
        "constraint_ref": {"type": "string", "minLength": 1}
      }
    },
    "cross_table_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["join_path", "join_fields", "relation_type", "constraint_ref"],
      "properties": {
        "join_path": {"type": "string", "minLength": 1},
        "join_fields": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "constraint_ref": {"type": "string", "minLength": 1}
      }
    },
    "time_amount_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_type", "expression"],
      "properties": {
        "condition_type": {"enum": ["time_window", "threshold", "unit_conversion", "other"]},
        "expression": {"type": "string", "minLength": 1}
      }
    },
    "unobservable_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["penalty_fact_ref", "reason"],
      "properties": {
        "penalty_fact_ref": {"type": "string", "pattern": "^fact-[0-9]{3}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "mapping_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["penalty_fact_ref", "proxy_expression", "table_field_path", "asset_evidence_ref"],
      "properties": {
        "penalty_fact_ref": {"type": "string", "pattern": "^fact-[0-9]{3}$"},
        "proxy_expression": {"type": "string", "minLength": 1},
        "table_field_path": {"type": "string", "minLength": 1},
        "asset_evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "constraint_asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": {"enum": ["constraint_asset", "east_material", "model", "qna", "review"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_detail": {"type": "string"}
      }
    },
    "unresolved_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_ref", "reason", "needs_human_review"],
      "properties": {
        "item_ref": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "needs_human_review": {"type": "boolean"}
      }
    }
  }
}
