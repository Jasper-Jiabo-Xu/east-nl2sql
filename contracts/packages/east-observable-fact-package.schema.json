{
  "$id": "https://east.example/contracts/packages/east-observable-fact-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAST-OBSERVABLE-FACT-PACKAGE",
  "type": "object",
  "additionalProperties": false,
  "required": ["observable_facts", "coverage_status", "asset_version", "unresolved_items"],
  "properties": {
    "observable_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observable_fact"}},
    "coverage_status": {"enum": ["complete", "partial", "blocked"]},
    "asset_version": {"type": "string", "minLength": 1},
    "unresolved_items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["item", "reason", "needs_human_review"], "properties": {"item": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "needs_human_review": {"type": "boolean"}}}}
  },
  "$defs": {
    "observable_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["observable_fact_id", "penalty_fact_refs", "topic", "main_object", "query_grain", "entry_table", "related_tables_fields", "within_table_relations", "cross_table_relations", "time_amount_conditions", "observable_proxy", "observability_type", "unobservable_parts", "risk_screening_boundary", "mapping_matrix", "constraint_asset_refs"],
      "properties": {
        "observable_fact_id": {"type": "string", "minLength": 1},
        "penalty_fact_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "topic": {"type": "string", "minLength": 1}, "main_object": {"type": "string", "minLength": 1}, "query_grain": {"type": "string", "minLength": 1},
        "entry_table": {"type": "string", "minLength": 1},
        "related_tables_fields": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["table_id", "field_id", "purpose"], "properties": {"table_id": {"type": "string", "minLength": 1}, "field_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}}}},
        "within_table_relations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "cross_table_relations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "time_amount_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observable_proxy": {"type": "string", "minLength": 1}, "observability_type": {"enum": ["direct", "indirect", "unobservable"]},
        "unobservable_parts": {"type": "array", "items": {"type": "string", "minLength": 1}}, "risk_screening_boundary": {"type": "string", "minLength": 1},
        "mapping_matrix": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["penalty_fact_id", "proxy_expression", "table_field_path", "asset_evidence_ref"], "properties": {"penalty_fact_id": {"type": "string", "minLength": 1}, "proxy_expression": {"type": "string", "minLength": 1}, "table_field_path": {"type": "string", "minLength": 1}, "asset_evidence_ref": {"type": "string", "minLength": 1}}}},
        "constraint_asset_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
