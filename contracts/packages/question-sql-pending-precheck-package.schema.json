{
  "$id": "https://east.example/contracts/packages/question-sql-pending-precheck-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUESTION-SQL-PENDING-PRECHECK",
  "description": "150 生成、160 消费的冻结 question-SQL 候选 payload。",
  "type": "object", "additionalProperties": false,
  "required": ["candidate_id", "query_spec_ref", "penalty_fact_package_ref", "observable_fact_package_ref", "clear_question", "sql_gold", "query_parameter_bindings", "sql_explanation", "business_event_candidates", "specification_mapping", "evidence_refs", "sql_dialect"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "query_spec_ref": {"$ref": "#/$defs/ref"},
    "penalty_fact_package_ref": {"$ref": "#/$defs/ref"},
    "observable_fact_package_ref": {"$ref": "#/$defs/ref"},
    "clear_question": {"type": "string", "minLength": 1},
    "sql_gold": {"type": "string", "minLength": 1},
    "query_parameter_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "source_pointer"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "source_pointer": {"type": "string", "pattern": "^/(query_entry/entry_conditions|filters_and_evidence)/(0|[1-9][0-9]*)/value$"}}}},
    "sql_explanation": {"type": "object", "additionalProperties": false, "required": ["select", "from_join", "where", "aggregation", "sort", "business_meaning"], "properties": {"select": {"type": "string", "minLength": 1}, "from_join": {"type": "string", "minLength": 1}, "where": {"type": "string"}, "aggregation": {"type": "string"}, "sort": {"type": "string"}, "business_meaning": {"type": "string", "minLength": 1}}},
    "business_event_candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["event_name", "objective", "objects", "state_changes"], "properties": {"event_name": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "objects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "state_changes": {"type": "array", "items": {"type": "string"}}}}},
    "specification_mapping": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["spec_item", "question_fragment", "sql_fragment"], "properties": {"spec_item": {"type": "string", "minLength": 1}, "question_fragment": {"type": "string", "minLength": 1}, "sql_fragment": {"type": "string", "minLength": 1}}}},
    "evidence_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "sql_dialect": {"const": "sqlite"}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
