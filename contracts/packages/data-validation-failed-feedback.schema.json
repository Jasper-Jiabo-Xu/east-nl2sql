{
  "$id": "https://east.example/contracts/packages/data-validation-failed-feedback/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data validation failed feedback (Agent 242 output, consumed by 241)",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "payload"],
  "properties": {
    "envelope": {
      "allOf": [
        {"$ref": "https://east.example/contracts/common-envelope/v1"},
        {
          "type": "object",
          "properties": {
            "artifact_type": {"const": "data_validation_failed_feedback"},
            "producer_id": {"const": "242"}
          }
        }
      ]
    },
    "payload": {"$ref": "#/$defs/feedback_payload"}
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "record_field_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_group_id", "record_id", "table_id", "field_id"],
      "properties": {
        "data_group_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "table_id": {"type": "string", "minLength": 1},
        "field_id": {"type": ["string", "null"]}
      }
    },
    "failed_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_module_ids", "constraint_ids", "record_field_locations", "expected_values", "actual_values", "error_details"],
      "properties": {
        "failed_module_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "constraint_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "record_field_locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record_field_location"}},
        "expected_values": {"type": "array", "items": {}},
        "actual_values": {"type": "array", "items": {}},
        "error_details": {"type": "string", "minLength": 1}
      }
    },
    "feedback_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "data_package_ref", "decision", "validator_registry_version", "failed_items"],
      "properties": {
        "schema_version": {"const": "v5.data-validation-failed-feedback/v1"},
        "data_package_ref": {"$ref": "#/$defs/artifact_ref"},
        "decision": {"const": "fail"},
        "validator_registry_version": {"type": "string", "minLength": 1},
        "failed_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failed_item"}}
      }
    }
  }
}
