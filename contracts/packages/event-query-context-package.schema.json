{
  "$id": "https://east.example/contracts/packages/event-query-context-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVENT-QUERY-CONTEXT",
  "type": "object", "additionalProperties": false, "required": ["envelope", "payload"],
  "properties": {
    "envelope": {"allOf": [
      {"$ref": "https://east.example/contracts/common-envelope/v1"},
      {"type": "object", "properties": {"artifact_type": {"const": "event_query_context"}, "producer_id": {"const": "210"}, "mode": {"const": "event_data"}}}
    ]},
    "payload": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "source_query_spec_ref", "source_question_sql_ref", "reviewed_question_sql_ref", "field_projection", "projection_hash"],
      "properties": {
        "schema_version": {"const": "v5.event-query-context/v1"},
        "source_query_spec_ref": {"$ref": "#/$defs/ref"},
        "source_question_sql_ref": {"$ref": "#/$defs/ref"},
        "reviewed_question_sql_ref": {"$ref": "#/$defs/ref"},
        "field_projection": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["spec_item", "fields"], "properties": {"spec_item": {"type": "string", "minLength": 1}, "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"}}}}},
        "projection_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
