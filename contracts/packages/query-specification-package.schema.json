{
  "$id": "https://east.example/contracts/packages/query-specification-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUERY-SPECIFICATION-PACKAGE",
  "description": "Query specification package produced by 140, consumed by 150/170/180/220/260.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_spec_id",
    "penalty_fact_package_ref",
    "observable_fact_package_ref",
    "query_goal",
    "must_preserve_fact_refs",
    "main_object_and_grain",
    "query_entry",
    "related_objects_and_path",
    "filters_and_evidence",
    "return_fields",
    "aggregation_dedup_sort_time",
    "observability_boundary",
    "expected_result_shape",
    "sql_schema_scope",
    "minimum_positive_count",
    "minimum_negative_count",
    "condition_coverage",
    "code_value_coverage",
    "expected_row_group_count",
    "join_expansion_limit",
    "query_specification_package_schema_version"
  ],
  "properties": {
    "query_spec_id": {
      "type": "string",
      "pattern": "^qspec-[0-9]{3}$",
      "description": "查询规格标识；稳定编号"
    },
    "penalty_fact_package_ref": {
      "$ref": "#/$defs/artifact_ref",
      "description": "处罚事实包引用；固定保存被引用产物的artifact_id、version、content_hash"
    },
    "observable_fact_package_ref": {
      "$ref": "#/$defs/artifact_ref",
      "description": "EAST可观察事实包引用；固定保存被引用产物的artifact_id、version、content_hash"
    },
    "query_goal": {
      "type": "string",
      "minLength": 1,
      "description": "查询目标；风险筛查目标"
    },
    "must_preserve_fact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "必须保留事实引用；penalty_fact_id列表"
    },
    "main_object_and_grain": {
      "$ref": "#/$defs/object_grain",
      "description": "主对象和粒度；查询主对象及结果粒度"
    },
    "query_entry": {
      "$ref": "#/$defs/query_entry",
      "description": "查询入口；入口表和入口条件"
    },
    "related_objects_and_path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/related_object"
      },
      "description": "关联对象与穿透路径；有序对象、表和关联"
    },
    "filters_and_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter_evidence"
      },
      "description": "筛选条件及证据；字段、运算符、值、单位和证据引用"
    },
    "return_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/return_field"
      },
      "description": "返回字段；字段ID、展示含义和来源表"
    },
    "aggregation_dedup_sort_time": {
      "$ref": "#/$defs/aggregation_spec",
      "description": "聚合去重排序时间；GROUP BY、DISTINCT、ORDER BY和时间窗口要求"
    },
    "observability_boundary": {
      "$ref": "#/$defs/observability_boundary",
      "description": "可观察性边界；可回答和不可回答内容"
    },
    "expected_result_shape": {
      "$ref": "#/$defs/result_shape",
      "description": "预期结果形态；行粒度、列集合、聚合形态"
    },
    "sql_schema_scope": {
      "$ref": "#/$defs/sql_scope",
      "description": "SQL表字段范围；SQL允许使用的表和字段"
    },
    "minimum_positive_count": {
      "type": "integer",
      "minimum": 1,
      "description": "最少正例数量；正整数"
    },
    "minimum_negative_count": {
      "type": "integer",
      "minimum": 1,
      "description": "最少反例数量；正整数"
    },
    "condition_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition_coverage_item"
      },
      "description": "条件覆盖要求；每个关键谓词需要的正例、反例类型"
    },
    "code_value_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code_value_coverage_item"
      },
      "description": "码值覆盖要求；字段ID及目标码值列表"
    },
    "expected_row_group_count": {
      "$ref": "#/$defs/row_group_count",
      "description": "结果行数/分组数；最小值、目标值和允许范围"
    },
    "join_expansion_limit": {
      "$ref": "#/$defs/join_limit",
      "description": "JOIN发散上限；最大倍率或最大结果数"
    },
    "query_specification_package_schema_version": {
      "const": "query-specification-v1",
      "description": "包协议版本"
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "object_grain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_object", "grain"],
      "properties": {
        "main_object": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "query_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_table", "entry_conditions"],
      "properties": {
        "entry_table": {
          "type": "string",
          "minLength": 1
        },
        "entry_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_id", "operator", "value"],
            "properties": {
              "field_id": {"type": "string", "minLength": 1},
              "operator": {"type": "string", "minLength": 1},
              "value": {"type": ["string", "number", "null"]}
            }
          }
        }
      }
    },
    "related_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_name", "table_id", "relation_type"],
      "properties": {
        "object_name": {"type": "string", "minLength": 1},
        "table_id": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "join_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_field", "to_field"],
            "properties": {
              "from_field": {"type": "string", "minLength": 1},
              "to_field": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "filter_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "operator", "value", "evidence_ref"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "null"]},
        "unit": {"type": "string"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "return_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "display_name", "source_table"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "source_table": {"type": "string", "minLength": 1}
      }
    },
    "aggregation_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_by_fields"],
      "properties": {
        "group_by_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "distinct_required": {"type": "boolean"},
        "order_by": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_id", "direction"],
            "properties": {
              "field_id": {"type": "string", "minLength": 1},
              "direction": {"enum": ["ASC", "DESC"]}
            }
          }
        },
        "time_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_id", "window_type"],
          "properties": {
            "field_id": {"type": "string", "minLength": 1},
            "window_type": {"enum": ["rolling", "fixed", "point"]}
          }
        }
      }
    },
    "observability_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerable", "unanswerable"],
      "properties": {
        "answerable": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "unanswerable": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "result_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_grain", "column_set", "aggregation_shape"],
      "properties": {
        "row_grain": {"type": "string", "minLength": 1},
        "column_set": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "aggregation_shape": {"enum": ["none", "group_by", "distinct", "top_n"]}
      }
    },
    "sql_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_tables"],
      "properties": {
        "allowed_tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table_id", "allowed_fields"],
            "properties": {
              "table_id": {"type": "string", "minLength": 1},
              "allowed_fields": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "condition_coverage_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "positive_types", "negative_types"],
      "properties": {
        "predicate": {"type": "string", "minLength": 1},
        "positive_types": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "negative_types": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "code_value_coverage_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "target_code_values"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "target_code_values": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "row_group_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "target", "tolerance_range"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "target": {"type": "integer", "minimum": 0},
        "tolerance_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": {"type": "integer"},
            "high": {"type": "integer"}
          }
        }
      }
    },
    "join_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_multiplier", "max_result_rows"],
      "properties": {
        "max_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "max_result_rows": {"type": "integer", "minimum": 1}
      }
    }
  }
}
