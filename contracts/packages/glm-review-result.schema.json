{
  "$id": "https://east.example/contracts/packages/glm-review-result/v1", "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "GLM-REVIEW-RESULT", "type": "object", "additionalProperties": false,
  "required": ["reviewed_package_ref", "semantic_review_report"],
  "properties": {"reviewed_package_ref": {"$ref": "#/$defs/ref"}, "semantic_review_report": {"$ref": "#/$defs/report"}},
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "report": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "decision", "error_types", "error_details", "evidence_refs", "route_suggestion"], "properties": {"reviewer_id": {"const": "180"}, "decision": {"enum": ["yes", "no"]}, "error_types": {"type": "array", "items": {"enum": ["FACT_PACKAGE_ERROR", "OBSERVABLE_MAPPING_ERROR", "QUERY_SPEC_ERROR", "QUESTION_SQL_ERROR", "BUSINESS_EVENT_ERROR", "QUESTION_FACT_OMISSION"]}}, "error_details": {"type": "array", "items": {"type": "object"}}, "evidence_refs": {"type": "array", "items": {"type": "object"}}, "route_suggestion": {"enum": ["120", "130", "140", "150"]}}}}}
