{
  "$id": "https://east.example/contracts/packages/precheck-failed-feedback-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRECHECK-FAILED-FEEDBACK-PAYLOAD",
  "description": "Payload schema for precheck failure feedback produced by 160, consumed by 150 for retry/escalation. Contains the specific precheck violations that caused SQL candidate rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pending_precheck_package_ref",
    "decision",
    "failed_checks",
    "attempt_no",
    "retry_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "v5.precheck-failed-feedback/v1",
      "description": "包协议版本"
    },
    "pending_precheck_package_ref": {
      "$ref": "#/$defs/artifact_ref",
      "description": "被拒绝的待预检包引用"
    },
    "decision": {
      "type": "string",
      "enum": ["fail", "blocked_manual"],
      "description": "判定；fail=可重试，blocked_manual=三次失败后需人工介入"
    },
    "failed_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/failed_check"
      },
      "description": "失败检查项列表"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "当前尝试次数"
    },
    "retry_eligible": {
      "type": "boolean",
      "description": "是否可重试；attempt_no<3且decision=fail时为true"
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "failed_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "check_type", "error_code", "error_details"],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1,
          "description": "检查项标识；与pending-precheck包中expected_checks.check_id对应"
        },
        "check_type": {
          "type": "string",
          "enum": ["syntax", "scope", "parameter_type", "result_row_limit", "safety_gate"],
          "description": "检查类型"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "description": "错误码；具体失败原因标识"
        },
        "error_details": {
          "type": "string",
          "minLength": 1,
          "description": "错误详情；人类可读的失败说明"
        },
        "offending_segment": {
          "type": "string",
          "description": "违规SQL片段；定位问题位置"
        }
      }
    }
  }
}
