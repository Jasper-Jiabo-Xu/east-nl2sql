{
  "$id": "https://east.example/contracts/packages/precheck-failed-feedback-package/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRECHECK-FAILED-FEEDBACK",
  "description": "160 产生、150 消费的冻结确定性预审失败反馈 payload。",
  "type": "object", "additionalProperties": false,
  "required": ["candidate_ref", "precheck_decision", "failed_items"],
  "properties": {
    "candidate_ref": {"$ref": "#/$defs/ref"},
    "precheck_decision": {"const": "fail"},
    "failed_items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["failed_rule_ids", "error_locations", "expected_values", "actual_values", "error_details"], "properties": {"failed_rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "error_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "expected_values": {}, "actual_values": {}, "error_details": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "content_hash"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
