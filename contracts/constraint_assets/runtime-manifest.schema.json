{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://east.example/contracts/constraint-assets/runtime-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": "v5.constraint-assets-runtime-manifest/v1"},
    "assets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_type", "asset_version", "content_hash", "payload"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_type": {"enum": ["constraint_asset_ref", "typed_reference_graph_ref"]},
          "asset_version": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["locator", "sha256"], "properties": {"locator": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
          }
        }
      }
    }
  }
}
