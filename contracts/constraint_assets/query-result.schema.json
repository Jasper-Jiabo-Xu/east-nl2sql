{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://east.example/contracts/constraint-assets/query-result/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "artifact_id", "asset_version", "content_hash", "query_method", "table_code", "query_parameters", "total", "returned_count", "complete", "cursor", "next_cursor", "source_hash", "records_hash", "receipt_hash", "service_proof", "records"],
  "properties": {
    "schema_version": {"const": "v5.constraint-asset-query-result/v2"},
    "artifact_type": {"enum": ["constraint_asset_ref", "typed_reference_graph_ref"]},
    "artifact_id": {"type": "string"},
    "asset_version": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_method": {"enum": ["asset_ref", "constraints_for_table", "field_rules_for_table", "graph_edges_for_table"]},
    "table_code": {"type": "string", "minLength": 1},
    "query_parameters": {"type": "object", "additionalProperties": false, "required": ["page_size"], "properties": {"page_size": {"type": "integer", "minimum": 1, "maximum": 500}}},
    "total": {"type": "integer", "minimum": 0},
    "returned_count": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"},
    "cursor": {"type": ["string", "null"]},
    "next_cursor": {"type": ["string", "null"]},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "service_proof": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {"type": "array"}
  }
}
