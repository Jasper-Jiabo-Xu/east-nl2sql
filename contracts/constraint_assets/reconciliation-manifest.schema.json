{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://east.example/contracts/constraint-assets/reconciliation-manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset", "human_override", "registered_files", "legacy_source_facts", "excluded_assets"],
  "properties": {
    "schema_version": {"const": "v5.constraint-assets-reconciliation/v1"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_version", "artifact_id", "content_hash"],
      "properties": {
        "asset_version": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "human_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_id", "effective_role", "authority", "decision"],
      "properties": {
        "comment_id": {"type": "string", "minLength": 1},
        "effective_role": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1}
      }
    },
    "registered_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "relative_path", "sha256", "registered_in_legacy_manifest"],
        "properties": {
          "role": {"enum": ["single_field", "local_codes", "national_codes"]},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "registered_in_legacy_manifest": {"type": "boolean"}
        }
      }
    },
    "legacy_source_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_manifest_path", "legacy_publication_status", "legacy_not_in_scope", "preservation_rule"],
      "properties": {
        "legacy_manifest_path": {"type": "string", "minLength": 1},
        "legacy_publication_status": {"type": "string", "minLength": 1},
        "legacy_not_in_scope": {"type": "array", "items": {"type": "string"}},
        "preservation_rule": {"type": "string", "minLength": 1}
      }
    },
    "excluded_assets": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
