{
  "$id": "https://east.example/contracts/common-envelope/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COMMON-ENVELOPE",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "run_id", "qa_id", "version", "schema_version", "content_hash", "supersedes_ref", "attempt_no", "producer_id", "parent_artifact_refs", "input_hashes", "status", "mode", "created_at", "trace_id", "storage_locator"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "qa_id": {"type": ["string", "null"]},
    "version": {"type": "integer", "minimum": 1},
    "schema_version": {"const": "COMMON-ENVELOPE/v1"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supersedes_ref": {"$ref": "#/$defs/artifact_ref_or_null"},
    "attempt_no": {"type": "integer", "minimum": 1, "maximum": 3},
    "producer_id": {"type": "string", "minLength": 1},
    "parent_artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "input_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "status": {"enum": ["candidate", "pending_validation", "validated", "pending_review", "approved", "rejected", "blocked_manual", "released"]},
    "mode": {"enum": ["question_sql", "event_data", "foundation"]},
    "created_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 1},
    "storage_locator": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "foundation"}}},
      "then": {"properties": {"qa_id": {"type": ["string", "null"]}}},
      "else": {"properties": {"qa_id": {"type": "string", "minLength": 1}}}
    }
  ],
  "$defs": {
    "artifact_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "version", "content_hash"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "version": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact_ref_or_null": {"anyOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]}
  }
}
