{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DATABASE-READ-SNAPSHOT/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "database_version", "database_sha256", "snapshot_sha256", "created_at", "storage_locator"],
  "properties": {
    "schema_version": {"const": "DATABASE-READ-SNAPSHOT/v1"},
    "database_version": {"type": "string", "minLength": 1},
    "database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "storage_locator": {"type": "string", "minLength": 1}
  }
}
