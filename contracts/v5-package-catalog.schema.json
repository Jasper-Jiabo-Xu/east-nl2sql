{
  "$id": "https://east.example/contracts/v5-package-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packages"],
  "properties": {
    "schema_version": {"const": "v5.package-catalog/v1"},
    "packages": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "producer", "consumers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "producer": {"type": "string", "minLength": 1},
          "consumers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "modes": {"type": "array", "minItems": 1, "items": {"enum": ["event", "foundation"]}},
          "description": {"type": "string", "minLength": 1},
          "payload_schema": {"type": "string", "minLength": 1},
          "package_schema": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"id": {"const": "question_sql_dual_review_passed"}}},
            "then": {
              "required": ["modes", "payload_schema", "package_schema"],
              "properties": {
                "producer": {"const": "110"},
                "consumers": {"const": ["210"]},
                "modes": {"const": ["event"]},
                "payload_schema": {"const": "v5.question-sql-dual-review-passed/v1"},
                "package_schema": {"const": "contracts/packages/question-sql-dual-review-passed-package.schema.json"}
              }
            }
          },
          {
            "if": {"properties": {"id": {"const": "query_parameter_binding"}}},
            "then": {"required": ["modes", "payload_schema", "package_schema"], "properties": {"producer": {"const": "110"}, "consumers": {"const": ["210", "260"]}, "modes": {"const": ["event"]}, "payload_schema": {"const": "v5.query-parameter-binding/v1"}, "package_schema": {"const": "contracts/packages/query-parameter-binding-package.schema.json"}}}
          },
          {
            "if": {"properties": {"id": {"const": "reviewed_question_sql"}}},
            "then": {
              "required": ["modes", "payload_schema", "package_schema"],
              "properties": {
                "producer": {"const": "210"},
                "consumers": {"const": ["150", "220", "260"]},
                "modes": {"const": ["event"]},
                "payload_schema": {"const": "v5.reviewed-question-sql/v1"},
                "package_schema": {"const": "contracts/packages/reviewed-question-sql-package.schema.json"}
              }
            }
          },
          {
            "if": {"properties": {"id": {"const": "event_query_context"}}},
            "then": {"required": ["modes", "payload_schema", "package_schema"], "properties": {"producer": {"const": "210"}, "consumers": {"const": ["220", "260"]}, "modes": {"const": ["event"]}, "payload_schema": {"const": "v5.event-query-context/v2"}, "package_schema": {"const": "contracts/packages/event-query-context-package.schema.json"}}}
          },
          {
            "if": {"properties": {"id": {"const": "release_candidate"}}},
            "then": {
              "required": ["modes", "payload_schema", "package_schema"],
              "properties": {
                "producer": {"const": "210"},
                "consumers": {"const": ["010"]},
                "modes": {"const": ["event", "foundation"]},
                "payload_schema": {"const": "v5.release-candidate/v1"},
                "package_schema": {"const": "contracts/packages/release-candidate-package.schema.json"}
              }
            }
          },
          {
            "if": {"properties": {"id": {"const": "release_receipt"}}},
            "then": {
              "required": ["modes", "payload_schema", "package_schema"],
              "properties": {
                "producer": {"const": "010"},
                "consumers": {"const": []},
                "modes": {"const": ["event", "foundation"]},
                "payload_schema": {"const": "v5.formal-release-receipt/v1"},
                "package_schema": {"const": "contracts/packages/formal-release-receipt.schema.json"}
              }
            }
          },
          {
            "if": {"properties": {"id": {"const": "foundation_profile"}}},
            "then": {
              "required": ["modes", "payload_schema", "package_schema"],
              "properties": {
                "producer": {"const": "210"},
                "consumers": {"const": ["220", "241"]},
                "modes": {"const": ["foundation"]},
                "payload_schema": {"const": "v5.foundation-profile/v1"},
                "package_schema": {"const": "contracts/packages/foundation-profile-package.schema.json"}
              }
            }
          },
          {
            "if": {"properties": {"id": {"const": "foundation_task_package"}}},
            "then": {
              "required": ["modes", "payload_schema", "package_schema"],
              "properties": {
                "producer": {"const": "210"},
                "consumers": {"const": ["220", "241", "260"]},
                "modes": {"const": ["foundation"]},
                "payload_schema": {"const": "v5.foundation-task-package/v1"},
                "package_schema": {"const": "contracts/packages/foundation-task-package.schema.json"}
              }
            }
          }
        ]
      }
    }
  }
}
