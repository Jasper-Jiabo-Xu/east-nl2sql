        <mxCell id="gmeiUcpRBea9TMHxDYsM-49" parent="1" style="swimlane;whiteSpace=wrap;html=1;strokeColor=light-dark(#999999,#cccccc);strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=light-dark(#333333,#cccccc);fillColor=light-dark(#eeeeee,#1f2020);" value="查询规格" vertex="1">
