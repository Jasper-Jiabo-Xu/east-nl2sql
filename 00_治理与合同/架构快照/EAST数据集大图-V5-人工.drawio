  <diagram id="east-v5-penalty-question-flow" name="V5流程-question-sql">
    <mxGraphModel dx="3655" dy="1580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% =========================\n%% 1. 监管处罚事实构造\n%% =========================\nsubgraph PENALTY[\&quot;一、监管处罚不可丢失事实构造\&quot;]\n    direction LR\n\n    RAW[\&quot;监管处罚原始材料\&quot;]\n\n    SOURCE_BUILDER[\&quot;监管处罚来源包构建器&lt;br/&gt;硬编码&lt;br/&gt;哈希 · 切分 · 稳定ID · 元数据\&quot;]\n\n    SOURCE_PACK[\&quot;监管处罚来源包&lt;br/&gt;原文 · source_id · source_span_id&lt;br/&gt;文件版本 · 来源元数据\&quot;]\n\n    FACT_AGENT[\&quot;监管处罚不可丢失事实构造 Agent&lt;br/&gt;原文拆解 + 互联网检索 + LLM思考\&quot;]\n\n    WEB[\&quot;互联网检索能力&lt;br/&gt;监管规则 · 适用时点&lt;br/&gt;业务含义 · 处罚背景\&quot;]\n\n    FACT_GATE[\&quot;监管处罚事实包硬闸门&lt;br/&gt;硬编码&lt;br/&gt;Schema · 固定码值 · 原文引用&lt;br/&gt;URL · 发布机构 · 日期 · 证据追溯\&quot;]\n\n    FACT_PACK[\&quot;监管处罚事实包&lt;br/&gt;不可丢失处罚事实 · 监管规则&lt;br/&gt;业务含义 · 处罚背景&lt;br/&gt;外部证据 · 冲突与不确定项\&quot;]\n\n    RAW --&gt; SOURCE_BUILDER\n    SOURCE_BUILDER --&gt; SOURCE_PACK\n    SOURCE_PACK --&gt; FACT_AGENT\n    WEB -.-&gt;|\&quot;检索工具\&quot;| FACT_AGENT\n    FACT_AGENT --&gt; FACT_GATE\n    FACT_GATE --&gt;|\&quot;通过\&quot;| FACT_PACK\n    FACT_GATE -.-&gt;|\&quot;未通过：返回结构化错误\&quot;| FACT_AGENT\nend\n\n%% =========================\n%% 2. EAST 可观察事实构造\n%% =========================\nsubgraph OBSERVABLE[\&quot;二、EAST 可观察事实构造\&quot;]\n    direction LR\n\n    EAST_KNOWLEDGE[\&quot;版本化 EAST 表字段知识包&lt;br/&gt;全表/全字段解释 · 数据元&lt;br/&gt;别名 · 主题 · 版本号\&quot;]\n\n    EAST_AGENT[\&quot;EAST 可观察事实构造 Agent&lt;br/&gt;初步分析主题、表、字段和关联&lt;br/&gt;判断如何观察且不丢失处罚事实\&quot;]\n\n    ASSET_AGENT[\&quot;资产检索 Agent&lt;br/&gt;公共通用 Agent&lt;br/&gt;查询意图 → 查询计划/候选SQL&lt;br/&gt;可嵌入经验证的 NL2SQL 工具\&quot;]\n\n    SQL_GATE[\&quot;只读 SQL 安全闸门&lt;br/&gt;硬编码&lt;br/&gt;仅 SELECT · AST 校验 · 表白名单&lt;br/&gt;LIMIT · 超时 · 审计日志\&quot;]\n\n    KB[(\&quot;约束资产 SQLite&lt;br/&gt;版本化只读连接\&quot;)]\n\n    ASSET_RESULT[\&quot;约束资产查询结果&lt;br/&gt;原始记录 · 约束摘要 · source_refs&lt;br/&gt;SQL · 参数 · 资产版本 · trace\&quot;]\n\n    OBSERVABLE_GATE{\&quot;可观察证据&lt;br/&gt;是否充分？\&quot;}\n\n    OBSERVABLE_PACK[\&quot;EAST 可观察事实包&lt;br/&gt;+ 相关约束资产摘要&lt;br/&gt;主题 · 主对象/粒度 · 表 · 字段&lt;br/&gt;关联 · 约束 · 可观察边界\&quot;]\n\n    OBSERVABLE_BLOCKED[\&quot;部分可观察 / 不可观察 / 人工阻断&lt;br/&gt;禁止为了满足而编造 EAST 映射\&quot;]\n\n    FACT_PACK --&gt; EAST_AGENT\n    EAST_KNOWLEDGE --&gt; EAST_AGENT\n\n    EAST_AGENT --&gt;|\&quot;明确查询指令\&quot;| ASSET_AGENT\n    ASSET_AGENT --&gt;|\&quot;查询计划/候选SQL\&quot;| SQL_GATE\n    SQL_GATE --&gt;|\&quot;安全 SELECT\&quot;| KB\n    KB --&gt; ASSET_RESULT\n    ASSET_RESULT --&gt; OBSERVABLE_GATE\n\n    OBSERVABLE_GATE --&gt;|\&quot;证据充分\&quot;| OBSERVABLE_PACK\n    OBSERVABLE_GATE -.-&gt;|\&quot;不足但可以继续补查\&quot;| EAST_AGENT\n    OBSERVABLE_GATE --&gt;|\&quot;不可观察或超过迭代上限\&quot;| OBSERVABLE_BLOCKED\nend\n\nASSET_NOTE[\&quot;资产检索 Agent 可被以下阶段复用&lt;br/&gt;question · SQL · data · 多层模块构造\&quot;]\nASSET_NOTE -.-&gt; ASSET_AGENT\n\n%% =========================\n%% 3. 查询规格与候选生成\n%% =========================\nsubgraph GENERATION[\&quot;三、查询规格与候选产物生成\&quot;]\n    direction LR\n\n    SPEC_AGENT[\&quot;查询规格 Agent&lt;br/&gt;构建查询目标、粒度、入口和穿透路径&lt;br/&gt;筛选条件 · 返回内容 · 聚合/去重&lt;br/&gt;风险筛查边界\&quot;]\n\n    SPEC[\&quot;查询规格&lt;br/&gt;question、SQL、业务事件的共同依据&lt;br/&gt;包含 penalty_fact_refs&lt;br/&gt;和 constraint_refs\&quot;]\n\n    CODEX_AGENT[\&quot;Codex 主生成 Agent&lt;br/&gt;联合生成候选产物&lt;br/&gt;不得自行批准\&quot;]\n\n    CANDIDATES[\&quot;候选产物包&lt;br/&gt;question · sql_gold · SQL解释&lt;br/&gt;业务事件候选 · 规格逐项映射&lt;br/&gt;完整 evidence mapping\&quot;]\n\n    FACT_PACK --&gt; SPEC_AGENT\n    OBSERVABLE_PACK --&gt; SPEC_AGENT\n    SPEC_AGENT --&gt; SPEC\n\n    FACT_PACK --&gt; CODEX_AGENT\n    OBSERVABLE_PACK --&gt; CODEX_AGENT\n    SPEC --&gt; CODEX_AGENT\n\n    CODEX_AGENT --&gt; CANDIDATES\nend\n\n%% =========================\n%% 4. 确定性预审\n%% =========================\nsubgraph PRECHECK[\&quot;四、确定性预审\&quot;]\n    direction LR\n\n    PRECHECK_ENGINE[\&quot;确定性预审器&lt;br/&gt;独立硬编码组件&lt;br/&gt;SQL AST与执行 · Schema与类型&lt;br/&gt;引用完整性 · 禁用项&lt;br/&gt;question 可机检项 · 输出格式\&quot;]\n\n    PRECHECK_RESULT{\&quot;确定性预审&lt;br/&gt;是否通过？\&quot;}\n\n    PRECHECK_ERROR[\&quot;结构化预审错误包&lt;br/&gt;error_code · location&lt;br/&gt;expected · actual · detail\&quot;]\n\n    CANDIDATES --&gt; PRECHECK_ENGINE\n    PRECHECK_ENGINE --&gt; PRECHECK_RESULT\n\n    PRECHECK_RESULT --&gt;|\&quot;否\&quot;| PRECHECK_ERROR\n    PRECHECK_ERROR -.-&gt;|\&quot;Codex 修改后重新预审\&quot;| CODEX_AGENT\nend\n\n%% =========================\n%% 5. DeepSeek 与 GLM 双审\n%% =========================\nsubgraph REVIEW[\&quot;五、DeepSeek 与 GLM 独立双审\&quot;]\n    direction TB\n\n    REVIEW_PACK[\&quot;双审审核包构建器&lt;br/&gt;硬编码&lt;br/&gt;监管处罚事实包&lt;br/&gt;EAST 可观察事实及约束资产摘要&lt;br/&gt;查询规格 · 候选产物 · 预审报告\&quot;]\n\n    DEEPSEEK[\&quot;DeepSeek 审核员 Agent&lt;br/&gt;独立输出&lt;br/&gt;YES/NO + 回退码 + 具体错误长文本\&quot;]\n\n    GLM[\&quot;GLM 审核员 Agent&lt;br/&gt;独立输出&lt;br/&gt;YES/NO + 回退码 + 具体错误长文本\&quot;]\n\n    REVIEW_ROUTER{\&quot;审核结果聚合与根因路由&lt;br/&gt;硬编码&lt;br/&gt;是否同一版本均为 YES？\&quot;}\n\n    PRECHECK_RESULT --&gt;|\&quot;是\&quot;| REVIEW_PACK\n    REVIEW_PACK --&gt; DEEPSEEK\n    REVIEW_PACK --&gt; GLM\n    DEEPSEEK --&gt; REVIEW_ROUTER\n    GLM --&gt; REVIEW_ROUTER\nend\n\n%% =========================\n%% 6. 回退与审批输出\n%% =========================\nsubgraph RESULT[\&quot;六、硬编码回退与审批输出\&quot;]\n    direction LR\n\n    RETRY_PACKAGE[\&quot;硬编码生成回退任务包&lt;br/&gt;&lt;br/&gt;R1：question-SQL 表达/一致性 → Codex&lt;br/&gt;R2：查询规格错误 → 查询规格 Agent&lt;br/&gt;R3：question 遗漏处罚事实 → Codex&lt;br/&gt;R4：EAST 映射/资产证据错误 → EAST Agent&lt;br/&gt;R5：处罚事实/外部证据错误 → 处罚事实 Agent&lt;br/&gt;&lt;br/&gt;修复后重新执行全部下游闸门\&quot;]\n\n    APPROVED_MIDDLE[\&quot;审批通过的中间产物&lt;br/&gt;监管处罚事实包&lt;br/&gt;EAST 可观察事实包&lt;br/&gt;相关约束资产摘要&lt;br/&gt;双审记录与完整 trace\&quot;]\n\n    APPROVED_DELIVERY[\&quot;审批通过的交付物&lt;br/&gt;查询规格 · question-SQL 对&lt;br/&gt;SQL解释 · 业务事件\&quot;]\n\n    DATA_STAGE[\&quot;进入业务事件—数据生成阶段\&quot;]\n\n    REVIEW_ROUTER --&gt;|\&quot;否：任一审核员为 NO\&quot;| RETRY_PACKAGE\n    REVIEW_ROUTER --&gt;|\&quot;是：同版均为 YES\&quot;| APPROVED_MIDDLE\n    REVIEW_ROUTER --&gt;|\&quot;是：同版均为 YES\&quot;| APPROVED_DELIVERY\n    APPROVED_DELIVERY --&gt; DATA_STAGE\nend\n\n%% =========================\n%% 样式\n%% =========================\nclassDef input fill:#EAF2F8,stroke:#5B8DB8,color:#17324D,stroke-width:1.5px;\nclassDef agent fill:#F3ECF8,stroke:#9675AA,color:#4B2E5D,stroke-width:2px;\nclassDef hardcode fill:#EAF6F2,stroke:#5D9F91,color:#214E45,stroke-width:1.5px;\nclassDef decision fill:#FFF3E5,stroke:#C9954A,color:#6B4315,stroke-width:1.5px;\nclassDef error fill:#FFF8FA,stroke:#BE7484,color:#6E2332,stroke-width:1.5px;\nclassDef storage fill:#F4F5F7,stroke:#64748B,color:#273444,stroke-width:1.5px;\nclassDef approved fill:#EAF6F2,stroke:#3B8C78,color:#174A3E,stroke-width:2px;\n\nclass RAW,SOURCE_PACK,FACT_PACK,EAST_KNOWLEDGE,ASSET_RESULT,OBSERVABLE_PACK,SPEC,CANDIDATES input;\nclass FACT_AGENT,EAST_AGENT,ASSET_AGENT,SPEC_AGENT,CODEX_AGENT,DEEPSEEK,GLM agent;\nclass SOURCE_BUILDER,FACT_GATE,SQL_GATE,PRECHECK_ENGINE,REVIEW_PACK hardcode;\nclass OBSERVABLE_GATE,PRECHECK_RESULT,REVIEW_ROUTER decision;\nclass OBSERVABLE_BLOCKED,PRECHECK_ERROR,RETRY_PACKAGE error;\nclass KB,ASSET_NOTE,WEB storage;\nclass APPROVED_MIDDLE,APPROVED_DELIVERY,DATA_STAGE approved;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="GePg7Vd3sR5QZvQ-W-7I-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1889" width="365" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style=&quot;color: light-dark(rgb(206, 181, 222), rgb(255, 255, 255));&quot;&gt;资产检索 Agent&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(206, 181, 222), rgb(255, 255, 255));&quot;&gt;&lt;span&gt;公共通用 Ag&lt;/span&gt;ent，&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(206, 181, 222), rgb(255, 255, 255));&quot;&gt;可被以下阶段复用&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(206, 181, 222), rgb(255, 255, 255));&quot;&gt;question · SQL · data · 多层模块构造&lt;/span&gt;&lt;/div&gt;" mermaidId="n:PENALTY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;verticalAlign=top;fillColor=light-dark(#ffffde,#1f2020);strokeColor=light-dark(#aaaa33,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="一、监管处罚不可丢失事实构造" id="GePg7Vd3sR5QZvQ-W-7I-96">
