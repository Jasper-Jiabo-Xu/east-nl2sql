        <UserObject label="当前 EAST 数据库" mermaidId="n:DB" mermaidBaseStyle="html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;strokeWidth=1.5;whiteSpace=wrap;fillColor=#F4F5F7;strokeColor=#64748B;fontColor=#273444;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="当前 EAST 数据库" id="wNHRyVD9AZMUk8oXzR6J-15">
