  <diagram id="east-v4-dual-agent-flow" name="V5流程-data">
    <mxGraphModel dx="2571" dy="1436" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% =========================\n%% 输入与闭包\n%% =========================\nsubgraph INPUT[\&quot;输入与闭包构造\&quot;]\n    CONSTRAINT[\&quot;约束资产\&quot;]\n    SQLSEED[\&quot;SQL 种子&lt;br/&gt;查询谓词与正例目标\&quot;]\n    EVENT[\&quot;审批通过的业务事件\&quot;]\n    FOUNDATION[\&quot;Foundation 铺底/扩容计划\&quot;]\n\n    STRUCTURE[\&quot;结构闭包&lt;br/&gt;表范围 · 字段范围 · 各层约束&lt;br/&gt;SQL 谓词/正例目标\&quot;]\n    OPERATION[\&quot;操作闭包&lt;br/&gt;READ · CHECK · INSERT · UPDATE&lt;br/&gt;对象—明细—状态顺序 · 事务边界\&quot;]\n\n    CONSTRAINT --&gt; STRUCTURE\n    SQLSEED --&gt; STRUCTURE\n    EVENT --&gt; OPERATION\n    STRUCTURE --&gt; OPERATION\n\n    FOUNDATION -.-&gt;|\&quot;铺底范围\&quot;| STRUCTURE\nend\n\nDB[(\&quot;当前 EAST 数据库\&quot;)]\n\n%% =========================\n%% 初始数据 Agent 通路\n%% =========================\nsubgraph DATA[\&quot;初始数据 Agent 通路\&quot;]\n    DATA_AGENT[\&quot;初始数据 Agent&lt;br/&gt;输入：结构闭包&lt;br/&gt;任务：结合现库构造候选插入数据\&quot;]\n\n    DB_QUERY[\&quot;数据库只读查询&lt;br/&gt;读取所需对象与当前状态\&quot;]\n\n    CANDIDATE_DATA[\&quot;候选数据暂存&lt;br/&gt;不提交、不直接写正式库\&quot;]\n\n    DATA_DISPATCH[\&quot;数据校验调度&lt;br/&gt;将同一批候选数据送往各层模块\&quot;]\n\n    CROSS_VALIDATOR[\&quot;跨表多字段约束模块&lt;br/&gt;硬编码校验&lt;br/&gt;返回 YES/NO + 违反约束\&quot;]\n\n    TABLE_VALIDATOR[\&quot;表模块&lt;br/&gt;74 个硬编码代码文件&lt;br/&gt;返回 YES/NO + 违反约束\&quot;]\n\n    FIELD_VALIDATOR[\&quot;字段模块&lt;br/&gt;1963 个硬编码代码文件&lt;br/&gt;返回 YES/NO + 违反约束\&quot;]\n\n    DATA_RESULT{\&quot;数据约束&lt;br/&gt;是否全部通过？\&quot;}\n\n    DATA_ERROR[\&quot;数据错误包&lt;br/&gt;汇总全部违反约束&lt;br/&gt;保留模块、记录与字段定位\&quot;]\n\n    STRUCTURE --&gt; DATA_AGENT\n    FOUNDATION -.-&gt;|\&quot;铺底模式\&quot;| DATA_AGENT\n\n    DATA_AGENT --&gt;|\&quot;只读查询请求\&quot;| DB_QUERY\n    DB --&gt; DB_QUERY\n    DB_QUERY --&gt;|\&quot;对象与状态快照\&quot;| DATA_AGENT\n\n    DATA_AGENT --&gt; CANDIDATE_DATA\n    CANDIDATE_DATA --&gt; DATA_DISPATCH\n\n    DATA_DISPATCH --&gt; CROSS_VALIDATOR\n    DATA_DISPATCH --&gt; TABLE_VALIDATOR\n    DATA_DISPATCH --&gt; FIELD_VALIDATOR\n\n    CROSS_VALIDATOR --&gt; DATA_RESULT\n    TABLE_VALIDATOR --&gt; DATA_RESULT\n    FIELD_VALIDATOR --&gt; DATA_RESULT\n\n    DATA_RESULT --&gt;|\&quot;否\&quot;| DATA_ERROR\n    DATA_ERROR --&gt;|\&quot;返回修改候选数据\&quot;| DATA_AGENT\nend\n\n%% =========================\n%% ORM Agent 通路\n%% =========================\nsubgraph ORM[\&quot;ORM Agent 通路\&quot;]\n    ORM_AGENT[\&quot;ORM Agent&lt;br/&gt;输入：业务事件 + 结构闭包 + 操作闭包&lt;br/&gt;任务：编排可执行候选 ORM\&quot;]\n\n    CANDIDATE_ORM[\&quot;候选 ORM 暂存&lt;br/&gt;不执行、不直接写正式库\&quot;]\n\n    ORM_PRECHECK[\&quot;ORM 确定性安全预审&lt;br/&gt;闭包范围 · API 白名单 · 事务完整&lt;br/&gt;禁止裸 SQL 写入\&quot;]\n\n    ORM_PRECHECK_RESULT{\&quot;ORM 安全预审&lt;br/&gt;是否通过？\&quot;}\n\n    ORDER_VALIDATOR[\&quot;对象—明细—状态模块&lt;br/&gt;硬编码顺序校验&lt;br/&gt;返回 YES/NO + 违反约束\&quot;]\n\n    ORDER_RESULT{\&quot;操作顺序&lt;br/&gt;是否通过？\&quot;}\n\n    ORM_ERROR[\&quot;ORM 错误包&lt;br/&gt;汇总安全错误与顺序错误\&quot;]\n\n    EVENT --&gt; ORM_AGENT\n    STRUCTURE --&gt; ORM_AGENT\n    OPERATION --&gt; ORM_AGENT\n\n    ORM_AGENT --&gt; CANDIDATE_ORM\n    CANDIDATE_ORM --&gt; ORM_PRECHECK\n    ORM_PRECHECK --&gt; ORM_PRECHECK_RESULT\n\n    ORM_PRECHECK_RESULT --&gt;|\&quot;是\&quot;| ORDER_VALIDATOR\n    ORM_PRECHECK_RESULT --&gt;|\&quot;否\&quot;| ORM_ERROR\n\n    ORDER_VALIDATOR --&gt; ORDER_RESULT\n    ORDER_RESULT --&gt;|\&quot;否\&quot;| ORM_ERROR\n\n    ORM_ERROR --&gt;|\&quot;返回重新编排 ORM\&quot;| ORM_AGENT\nend\n\n%% =========================\n%% 双通路汇合、沙箱与回归\n%% =========================\nsubgraph COMBINE[\&quot;双通路汇合与回归\&quot;]\n    BINDING[\&quot;硬编码执行绑定闸门&lt;br/&gt;事件模式：ORM 操作与候选数据逐项绑定&lt;br/&gt;铺底模式：固定写入计划与候选数据绑定\&quot;]\n\n    BINDING_RESULT{\&quot;绑定是否通过？\&quot;}\n\n    SANDBOX[\&quot;沙箱事务执行&lt;br/&gt;在当前数据库快照上 INSERT / UPDATE&lt;br/&gt;失败立即回滚\&quot;]\n\n    REGRESSION[\&quot;SQL 回归与确定性闸门&lt;br/&gt;事件模式：Gold SQL、密度、JOIN 发散&lt;br/&gt;铺底模式：对象池与状态完整性\&quot;]\n\n    REGRESSION_RESULT{\&quot;回归是否通过？\&quot;}\n\n    JOINT_ERROR[\&quot;联合错误分类&lt;br/&gt;定位为数据错误、ORM 错误或绑定错误\&quot;]\n\n    COMMIT[\&quot;提交 INSERT / UPDATE&lt;br/&gt;生成 trace · manifest · receipt\&quot;]\n\n    DATA_RESULT --&gt;|\&quot;是\&quot;| BINDING\n    ORDER_RESULT --&gt;|\&quot;是：事件模式\&quot;| BINDING\n    FOUNDATION -.-&gt;|\&quot;固定对象/状态写入计划\&quot;| BINDING\n\n    BINDING --&gt; BINDING_RESULT\n    BINDING_RESULT --&gt;|\&quot;是\&quot;| SANDBOX\n    BINDING_RESULT --&gt;|\&quot;否\&quot;| JOINT_ERROR\n\n    DB --&gt;|\&quot;数据库快照\&quot;| SANDBOX\n    SANDBOX --&gt; REGRESSION\n    REGRESSION --&gt; REGRESSION_RESULT\n\n    REGRESSION_RESULT --&gt;|\&quot;否：回滚\&quot;| JOINT_ERROR\n    REGRESSION_RESULT --&gt;|\&quot;是\&quot;| COMMIT\n    COMMIT --&gt; DB\n\n    JOINT_ERROR --&gt;|\&quot;数据或字段值问题\&quot;| DATA_AGENT\n    JOINT_ERROR --&gt;|\&quot;ORM、顺序或事务问题\&quot;| ORM_AGENT\nend\n\n%% =========================\n%% 样式\n%% =========================\nclassDef input fill:#EAF2F8,stroke:#5B8DB8,color:#17324D,stroke-width:1.5px;\nclassDef agent fill:#F3ECF8,stroke:#9675AA,color:#4B2E5D,stroke-width:2px;\nclassDef validator fill:#EAF6F2,stroke:#5D9F91,color:#214E45,stroke-width:1.5px;\nclassDef decision fill:#FFF3E5,stroke:#C9954A,color:#6B4315,stroke-width:1.5px;\nclassDef error fill:#FFF8FA,stroke:#BE7484,color:#6E2332,stroke-width:1.5px;\nclassDef storage fill:#F4F5F7,stroke:#64748B,color:#273444,stroke-width:1.5px;\nclassDef success fill:#EAF6F2,stroke:#3B8C78,color:#174A3E,stroke-width:2px;\n\nclass CONSTRAINT,SQLSEED,EVENT,FOUNDATION,STRUCTURE,OPERATION input;\nclass DATA_AGENT,ORM_AGENT agent;\nclass CROSS_VALIDATOR,TABLE_VALIDATOR,FIELD_VALIDATOR,ORDER_VALIDATOR,DATA_DISPATCH,ORM_PRECHECK validator;\nclass DATA_RESULT,ORM_PRECHECK_RESULT,ORDER_RESULT,BINDING_RESULT,REGRESSION_RESULT decision;\nclass DATA_ERROR,ORM_ERROR,JOINT_ERROR error;\nclass DB,DB_QUERY,CANDIDATE_DATA,CANDIDATE_ORM,SANDBOX storage;\nclass COMMIT success;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wNHRyVD9AZMUk8oXzR6J-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
