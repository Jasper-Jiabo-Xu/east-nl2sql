        <mxCell id="gmeiUcpRBea9TMHxDYsM-50" parent="gmeiUcpRBea9TMHxDYsM-49" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=light-dark(#999999,#cccccc);strokeWidth=2;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=light-dark(#333333,#cccccc);fillColor=light-dark(#eeeeee,#1f2020);" value="&lt;div&gt;查询目标：&lt;/div&gt;&lt;div&gt;筛查贷款发放后，资金在限定时间内流入借款人关联企业的债项。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;查询入口：&lt;/div&gt;&lt;div&gt;债项层。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;主对象与粒度：&lt;/div&gt;&lt;div&gt;一笔贷款债项。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;关联对象：&lt;/div&gt;&lt;div&gt;借款人、关联企业、贷款发放记录、资金流水。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;筛选条件：&lt;/div&gt;&lt;div&gt;- 贷款已经发放；&lt;/div&gt;&lt;div&gt;- 在发放后的指定时间窗口内；&lt;/div&gt;&lt;div&gt;- 资金流入与借款人存在关联关系的企业；&lt;/div&gt;&lt;div&gt;- 流入金额达到规定阈值或比例。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;返回内容：&lt;/div&gt;&lt;div&gt;借款人、关联企业、债项标识、贷款发放日期、贷款金额、&lt;/div&gt;&lt;div&gt;资金流入日期、流入金额、关联关系类型。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;查询性质：&lt;/div&gt;&lt;div&gt;风险筛查，不直接认定贷款违规。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;预期穿透路径：&lt;/div&gt;&lt;div&gt;债项 → 借款人 → 关联关系 → 资金流水。&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="380" y="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
